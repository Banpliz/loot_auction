BOT_TOKEN=123456:ABC-DEF-your-bot-token
ADMIN_TELEGRAM_IDS=111111111,222222222
MINI_APP_URL=https://your-domain.example
PORT=3000
DATA_DIR=./data
# Only needed for invasion screenshot recognition (paid, per screenshot) — get one
# at console.anthropic.com. Feast-only deployments can leave this unset.
ANTHROPIC_API_KEY=
# Optional. Only set this if you're using a proxy/reseller that mirrors Anthropic's own
# API wire format (same x-api-key header, same /v1/messages shape) on its own domain,
# instead of paying Anthropic directly. Leave unset to call api.anthropic.com as normal.
# No trailing slash.
ANTHROPIC_BASE_URL=
